# syntax=docker/dockerfile:1
FROM dhi.io/ruby:3.4-dev AS build

WORKDIR /thing
ENV BUNDLE_DEPLOYMENT=1 \
    BUNDLE_PATH=/usr/local/bundle

COPY Gemfile Gemfile.lock ./
RUN gem install bundler -v 4.0.20 --no-document && \
    bundle install --jobs 4 --retry 3 && \
    rm -rf /usr/local/bundle/ruby/*/cache

FROM dhi.io/ruby:3.4 AS runtime

WORKDIR /thing
ENV BUNDLE_DEPLOYMENT=1 \
    BUNDLE_PATH=/usr/local/bundle \
    RACK_ENV=production

COPY --from=build /usr/local/bundle /usr/local/bundle
COPY . .

EXPOSE 9292
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["ruby", "-rnet/http", "-e", "response = Net::HTTP.get_response(URI(\"http://127.0.0.1:#{ENV.fetch('PORT', '9292')}/health\")); exit(response.is_a?(Net::HTTPSuccess) && response.body == 'ok' ? 0 : 1)"]
CMD ["bundle", "exec", "puma", "-C", "config/puma.rb"]
